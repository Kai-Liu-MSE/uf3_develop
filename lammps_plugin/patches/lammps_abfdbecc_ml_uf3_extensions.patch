+void PairUF3::create_cached_constants_2rho()
+{
+  for (auto &term : density_modulated_2b_terms) {
+    const int n_coefficients = static_cast<int>(term.coefficients.size());
+    term.spline_constants.clear();
+    term.derivative_constants.clear();
+    term.uniform_knots = false;
+    term.knot_spacing = 0.0;
+    if (n_coefficients <= 0 || static_cast<int>(term.knots.size()) != n_coefficients + 4) continue;
+
+    const double spacing = term.knots[4] - term.knots[3];
+    if (spacing > 0.0) {
+      term.uniform_knots = true;
+      for (int knot_index = 4; knot_index < n_coefficients; knot_index++) {
+        const double candidate = term.knots[knot_index + 1] - term.knots[knot_index];
+        if (std::abs(candidate - spacing) > 1.0e-8 * std::max(1.0, std::abs(spacing))) {
+          term.uniform_knots = false;
+          break;
+        }
+      }
+      if (term.uniform_knots) term.knot_spacing = spacing;
+    }
+
+    term.spline_constants.resize(n_coefficients);
+    for (int coefficient_index = 0; coefficient_index < n_coefficients; coefficient_index++) {
+      uf3_bspline_basis3 basis(lmp, &term.knots[coefficient_index],
+                               term.coefficients[coefficient_index]);
+      for (int constant_index = 0; constant_index < 16; constant_index++)
+        term.spline_constants[coefficient_index][constant_index] = basis.constants[constant_index];
+    }
+
+    if (n_coefficients < 2) continue;
+    term.derivative_constants.resize(n_coefficients - 1);
+    for (int coefficient_index = 0; coefficient_index < n_coefficients - 1; coefficient_index++) {
+      const double derivative_coefficient =
+          3.0 * (term.coefficients[coefficient_index + 1] -
+                 term.coefficients[coefficient_index]) /
+          (term.knots[coefficient_index + 4] - term.knots[coefficient_index + 1]);
+      uf3_bspline_basis2 basis(lmp, &term.knots[coefficient_index + 1],
+                               derivative_coefficient);
+      for (int constant_index = 0; constant_index < 9; constant_index++)
+        term.derivative_constants[coefficient_index][constant_index] = basis.constants[constant_index];
+    }
+  }
+}

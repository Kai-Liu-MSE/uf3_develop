+void PairUF3::write_timing_profile()
+{
+  double local[19] = {
+      timing_pair_total,
+      timing_density_force,
+      timing_dipole_force,
+      timing_2rho_force,
+      timing_2rho_energy,
+      timing_2rho_density,
+      timing_2rho_modulated,
+      timing_2rho_chain,
+      timing_moment_accumulation,
+      timing_2p_force,
+      timing_2p_energy,
+      timing_2d_force,
+      timing_2d_energy,
+      timing_2q_force,
+      timing_2q_energy,
+      timing_2a_force,
+      timing_2a_energy,
+      timing_2b_shortlist,
+      timing_3b_triplet,
+  };
+  double rank_max[19] = {0.0};
+  MPI_Reduce(local, rank_max, 19, MPI_DOUBLE, MPI_MAX, 0, world);
+
+  if (comm->me == 0) {
+    std::ofstream output(timing_profile_file, std::ios::app);
+    if (!output)
+      error->one(FLERR, "UF3: could not append to timing profile file");
+    output << update->ntimestep << ',' << timing_profile_calls;
+    for (double value : rank_max) output << ',' << std::setprecision(16) << value;
+    output << '\n';
+  }
+
+  timing_pair_total = 0.0;
+  timing_density_force = 0.0;
+  timing_density_energy = 0.0;
+  timing_dipole_force = 0.0;
+  timing_dipole_energy = 0.0;
+  timing_2rho_force = 0.0;
+  timing_2rho_energy = 0.0;

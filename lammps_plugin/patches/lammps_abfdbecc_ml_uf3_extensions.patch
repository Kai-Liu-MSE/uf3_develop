+void PairUF3::write_2rho_debug_density()
+{
+  if (!debug_2rho_density) return;
+
+  double **x = atom->x;
+  int *type = atom->type;
+  tagint *tag = atom->tag;
+  const int nlocal = atom->nlocal;
+  std::vector<double> rho(nlocal, 0.0);
+  std::vector<double> rho_bulk(nlocal, 0.0);
+  std::vector<double> e2rho(nlocal, 0.0);
+
+  for (int ii = 0; ii < list->inum; ii++) {
+    const int i = list->ilist[ii];
+    if (i >= nlocal) continue;
+    const int itype = type[i];
+    if (map[itype] < 0) continue;
+    int *jlist = list->firstneigh[i];
+    const int jnum = list->numneigh[i];
+    for (int jj = 0; jj < jnum; jj++) {
+      int j = jlist[jj] & NEIGHMASK;
+      const int jtype = type[j];
+      if ((map[jtype] < 0) || (setflag_2rho[itype][jtype] == 0)) continue;
+      const double delx = x[i][0] - x[j][0];
+      const double dely = x[i][1] - x[j][1];
+      const double delz = x[i][2] - x[j][2];
+      const double rij = std::sqrt(delx * delx + dely * dely + delz * delz);
+      const double r_min = rho_2rho_r_min[itype][jtype];
+      const double r_on = rho_2rho_r_on[itype][jtype];
+      const double r_cut = rho_2rho_r_cut[itype][jtype];
+      if ((rij <= r_min) || (rij >= r_cut)) continue;
+      double envelope = 1.0;
+      if (rij > r_on) {
+        const double t = (rij - r_on) / (r_cut - r_on);
+        envelope = 1.0 - 10.0 * t * t * t + 15.0 * t * t * t * t -
+                   6.0 * t * t * t * t * t;
+      }
+      rho[i] += rho_2rho_weight[itype][jtype] *
+          std::pow(rij, -rho_2rho_power[itype][jtype]) * envelope;
+    }
+    for (int neighbor_type = 1; neighbor_type <= atom->ntypes; neighbor_type++)
+      if (setflag_2rho[itype][neighbor_type] == 1)
+        rho_bulk[i] += rho_2rho_bulk[itype][neighbor_type];
+
+    const double x_normalized = rho_bulk[i] > 0.0 ? rho[i] / rho_bulk[i] : 0.0;
+    const double x_safe = std::max(x_normalized, 1.0e-12);
+    for (const auto &term : density_modulated_2b_terms) {
+      if (term.center_type != itype) continue;
+      const double modulation =
+          std::pow(x_safe, term.alpha) - 1.0 - term.alpha * (x_safe - 1.0);
+      if (modulation == 0.0) continue;
+      for (int jj = 0; jj < jnum; jj++) {
+        const int j = jlist[jj] & NEIGHMASK;
+        if (type[j] != term.neighbor_type) continue;
+        const double delx = x[i][0] - x[j][0];
+        const double dely = x[i][1] - x[j][1];
+        const double delz = x[i][2] - x[j][2];
+        const double rij = std::sqrt(delx * delx + dely * dely + delz * delz);
+        e2rho[i] += modulation * evaluate_2rho_cubic_spline(term, rij);
+      }
+    }
+  }
+
+  std::ofstream output(debug_2rho_density_prefix + "." + std::to_string(comm->me));
+  if (!output)
+    error->all(FLERR, "UF3: Could not open debug_rho output file");
+  output << "# id type rho rho_bulk x";
+  for (double alpha : rho_2rho_alphas) output << " g_" << alpha;
+  output << " e2rho\n";
+  output << std::setprecision(17);
+  for (int i = 0; i < nlocal; i++) {
+    const double x_normalized = rho_bulk[i] > 0.0 ? rho[i] / rho_bulk[i] : 0.0;
+    output << tag[i] << " " << type[i] << " " << rho[i] << " " << rho_bulk[i] << " "
+           << x_normalized;
+    for (double alpha : rho_2rho_alphas) {
+      const double x_safe = std::max(x_normalized, 1.0e-12);
+      const double modulation = std::pow(x_safe, alpha) - 1.0 - alpha * (x_safe - 1.0);
+      output << " " << modulation;
+    }
+    output << " " << e2rho[i] << "\n";
+  }
+}
